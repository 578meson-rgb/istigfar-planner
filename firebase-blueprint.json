{
  "entities": {
    "users": {
      "title": "User Profiles",
      "description": "User profile data and aggregate counts",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "totalCount": { "type": "number" },
        "todayCount": { "type": "number" },
        "lastActiveDate": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName"]
    },
    "userLogs": {
      "title": "User Logs",
      "description": "Daily Istighfar log entries for users",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "date": { "type": "string" },
        "count": { "type": "number" },
        "target": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "date", "count"]
    }
  }
}
